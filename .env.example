# Telegram Bot
BOT_TOKEN=123456789:ABCDEF_YourBotTokenHere
BOT_USERNAME=YourBotUsername

# Database Configuration
# For quick local testing with SQLite:
DATABASE_URL=sqlite+aiosqlite:///./ittestbot.db
# For production PostgreSQL with Docker Compose:
# POSTGRES_USER=ittestuser
# POSTGRES_PASSWORD=replace_with_strong_db_password
# POSTGRES_DB=ittestdb
# DATABASE_URL=postgresql+asyncpg://ittestuser:replace_with_strong_db_password@postgres:5432/ittestdb

# Security Keys (Generate with `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=replace_this_with_a_secure_random_64_char_hex_secret_key_1234567890abcdef
JOIN_CODE_PEPPER=replace_this_with_another_secret_pepper_for_join_codes_1234567890abcdef

# Admin & Web Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
ADMIN_SESSION_COOKIE_NAME=ittestbot_admin_session
COOKIE_SECURE=false

# Telegram Webhook (Leave empty for local polling mode)
WEBHOOK_URL=
WEBHOOK_SECRET_TOKEN=

# Quotas per user
MAX_GROUPS_PER_USER=20
MAX_QUESTIONS_PER_USER=500
MAX_SCHEDULES_PER_USER=50

# Scheduler
SCHEDULER_INTERVAL_SECONDS=10
SCHEDULER_GRACE_WINDOW_SECONDS=600
DEFAULT_TIMEZONE=Asia/Tashkent
# Randomize the order of answer options in posted quiz polls (true/false)
SHUFFLE_POLL_OPTIONS=true
